data/raw/*
!data/raw/.gitkeep

# DuckDB warehouse files
warehouse/*.duckdb
warehouse/*.duckdb.wal
*.duckdb
*.duckdb.wal

# Python
.venv/
__pycache__/
*.pyc

# dbt build artifacts
transform/target/
transform/dbt_packages/
transform/logs/
logs/

# Evidence / Node (dashboards/.gitignore covers Evidence's generated folders)
node_modules/

# Secrets and local settings
.env
.user.yml

# OS / editor clutter
.DS_Store
Thumbs.db
.vscode/
